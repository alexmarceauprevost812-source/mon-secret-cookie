#!/usr/bin/python3
"""Lanceur LexOS du projet existant, indépendant du répertoire courant."""
import os
from pathlib import Path
import sys


def main():
    source=Path(__file__).resolve()
    project=source.parent.parent if source.parent.name=='integration' else Path.home()/'LexOS-Projets/mon-secret-cookie'
    python=project/'.venv/bin/python'
    if not python.is_file() or not os.access(python,os.X_OK):
        print('Erreur : environnement Python manquant : '+str(python),file=sys.stderr)
        return 1
    bootstrap='import sys; sys.path.insert(0, '+repr(str(project))+'); from mon_secret_cookie.cli import main; sys.exit(main())'
    os.execv(str(python),[str(python),'-I','-B','-c',bootstrap,*sys.argv[1:]])


if __name__=='__main__':
    sys.exit(main())
